  "panels": [
    {
      "id": 1,
      "title": "Доступность сервисов",
      "description": "Состояние последней HTTP-проверки: 1 — успех, 0 — неудача. Нет данных проверки означает, что Prometheus не получил результат probe_success; это не успешная проверка. Проверяются health-эндпоинты, а не полные пользовательские сценарии.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(probe_success{job=\"services_http\"} and on(job, instance) (up{job=\"services_http\"} == 1)) or on(job, instance) (up{job=\"services_http\"} * 0 - 1)",
          "legendFormat": "{{service}}",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Нет данных проверки",
                  "color": "gray",
                  "index": 0
                },
                "0": {
                  "text": "Недоступен",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "Доступен",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "Нет данных",
          "decimals": 0,
          "min": -1,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
